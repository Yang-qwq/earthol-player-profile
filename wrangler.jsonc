{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earthol-player-profile",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [],
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "earthol-player-profile-d1"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV"
    }
  ],
  // Optional R2 object storage: uncomment to enable avatar + gallery-image
  // uploads in the dashboard. The code detects the binding at runtime and
  // hides/disables the upload feature when it is absent, so leaving this
  // commented keeps the app fully functional without R2 (gallery blocks keep
  // working with external image URLs). `bucket_name` may be any name —
  // Wrangler auto-provisions it (locally and on deploy), or point it at an
  // existing one.
  // "r2_buckets": [
  //   {
  //     "binding": "R2",
  //     "bucket_name": "earthol-player-profile-r2"
  //   }
  // ],
  // Optional Cloudflare Images binding: uncomment to re-encode gallery
  // uploads to WebP server-side before they are stored in R2. Independent of
  // the R2 binding — without R2 uploads stay disabled; without Images the
  // original bytes are stored unchanged.
  // "images": {
  //   "binding": "IMAGES"
  // },
  "env": {
    "production": {
      "name": "earthol-player-profile-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "earthol-player-profile-d1"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV"
        }
      ],
      // Uncomment together with the top-level block to enable avatar uploads
      // in production (same notes as above).
      // "r2_buckets": [
      //   {
      //     "binding": "R2",
      //     "bucket_name": "earthol-player-profile-r2"
      //   }
      // ],
      // (Images is not inherited into named environments — uncomment here
      // too, together with the top-level block.)
      // "images": {
      //   "binding": "IMAGES"
      // }
    }
  }
}